# Copy this file to `.env` and fill in your connection strings.
# Requires PostgreSQL >= 15.

# Pooled connection (pgBouncer) — used by the app at runtime
DATABASE_URL="postgresql://user:password@host/mydb?sslmode=require"

# Direct (unpooled) connection — used by Prisma CLI (db init, migration status)
# For Neon: use the connection string from the "Direct connection" section
DATABASE_URL_UNPOOLED="postgresql://user:password@host/mydb?sslmode=require"

# JWT
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

# App
PORT=4000
CLIENT_URL="http://localhost:5173"
